<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 仅在设置中开启「大模型问答」后使用，其余功能全部离线 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内语音记账（自绘识别界面，不弹系统丑页面） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 包可见性：允许查询语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".InkApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkLedger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.InkLedger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.quickentry.QuickEntryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.InkLedger.Translucent" />

        <receiver
            android:name=".widget.SmallWidgetReceiver"
            android:exported="false"
            android:label="妙计 · 简约">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver
            android:name=".widget.MediumWidgetReceiver"
            android:exported="false"
            android:label="妙计 · 标准">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info" />
        </receiver>
        <receiver
            android:name=".widget.LargeWidgetReceiver"
            android:exported="false"
            android:label="妙计 · 详尽">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>
        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:exported="false"
            android:label="妙计 · 收支">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.CountdownWidgetReceiver"
            android:exported="false"
            android:label="妙计 · 倒数日">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>
        <receiver
            android:name=".widget.HabitWidgetReceiver"
            android:exported="false"
            android:label="妙计 · 打卡">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_habit_info" />
        </receiver>
        <receiver
            android:name=".widget.HabitWidgetCheckReceiver"
            android:exported="false" />

        <!-- 添加倒数日/打卡小组件时的系统配置页（选择显示哪一条） -->
        <activity
            android:name=".widget.WidgetPickActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.InkLedger.Translucent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 小组件记录列表的适配器服务 -->
        <service
            android:name=".widget.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".data.auto.AutoRecordService"
            android:exported="true"
            android:label="@string/auto_record_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".data.auto.AutoConfirmReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
